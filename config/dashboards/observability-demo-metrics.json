{
  "id": null,
  "uid": "observability-demo-metrics",
  "title": "Observability Demo Metrics",
  "tags": ["observability", "app", "metrics", "sre"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "panels": [
    {
      "type": "graph",
      "title": "Traffic: Requests per Second",
      "description": "Tracks request rate by route so you can see demand patterns and traffic spikes.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "sum(rate(app_requests_total[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "yaxes": [
        { "format": "req/s", "label": "Requests per second", "logBase": 1, "min": 0, "show": true },
        { "format": "short", "show": false }
      ]
    },
    {
      "type": "graph",
      "title": "Latency: Request Duration (P95 / P99)",
      "description": "Shows 95th and 99th percentile request latency by route to surface slow user journeys.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(app_request_duration_bucket[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(app_request_duration_bucket[5m])) by (le, route))",
          "legendFormat": "p99 {{route}}",
          "refId": "B"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "yaxes": [
        { "format": "s", "label": "seconds", "logBase": 1, "min": 0, "show": true },
        { "format": "short", "show": false }
      ]
    },
    {
      "type": "graph",
      "title": "Errors: Rate and Percentage",
      "description": "Displays error volume and error rate so you can detect failing requests quickly.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "sum(rate(app_requests_errors_total[5m])) by (route)",
          "legendFormat": "errors {{route}}",
          "refId": "A"
        },
        {
          "expr": "100 * sum(rate(app_requests_errors_total[5m])) / sum(rate(app_requests_total[5m]))",
          "legendFormat": "error rate %",
          "refId": "B"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "yaxes": [
        { "format": "short", "label": "errors / sec", "logBase": 1, "min": 0, "show": true },
        { "format": "percent", "show": true }
      ]
    },
    {
      "type": "stat",
      "title": "SRE SLO: Success Rate",
      "description": "Shows the overall request success rate as the primary reliability SLO metric.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "100 * sum(rate(app_requests_success_total[5m])) / sum(rate(app_requests_total[5m]))",
          "legendFormat": "success rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Critical Journey: Compute Success Rate",
      "description": "Monitors success rate for the key compute user journey to catch regressions quickly.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "100 * sum(rate(app_requests_success_total{journey=\"compute\"}[5m])) / sum(rate(app_requests_total{journey=\"compute\"}[5m]))",
          "legendFormat": "compute success rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "type": "graph",
      "title": "Saturation: Process Memory RSS",
      "description": "Shows the app process resident memory usage in bytes to track memory saturation.",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "avg(app_process_memory_rss)",
          "legendFormat": "RSS memory",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "yaxes": [
        { "format": "bytes", "label": "bytes", "logBase": 1, "min": 0, "show": true },
        { "format": "short", "show": false }
      ]
    },
    {
      "type": "graph",
      "title": "Saturation: System Load Average (1m)",
      "description": "Shows the 1-minute system load average to detect CPU saturation and scheduling pressure.",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "avg(app_system_loadavg_1m)",
          "legendFormat": "loadavg 1m",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "yaxes": [
        { "format": "short", "label": "load", "logBase": 1, "min": 0, "show": true },
        { "format": "short", "show": false }
      ]
    },
    {
      "type": "graph",
      "title": "Saturation: Process CPU Usage Rate",
      "description": "Shows the process CPU usage rate to detect rising CPU saturation in the application.",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "sum(rate(app_process_cpu_seconds[5m]))",
          "legendFormat": "CPU sec/s",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "yaxes": [
        { "format": "s", "label": "seconds per second", "logBase": 1, "min": 0, "show": true },
        { "format": "short", "show": false }
      ]
    },
    {
      "type": "stat",
      "title": "SLO/Error Budget Burn",
      "description": "Estimates error-budget burn rate from recent error levels against a 99% success / 1% error budget SLA.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "100 * sum(rate(app_requests_errors_total[5m])) / sum(rate(app_requests_total[5m])) / 0.01",
          "legendFormat": "error budget burn %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Actionable Alert Indicator",
      "description": "Shows whether any high-priority error, latency, or saturation thresholds are currently tripped.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "sum((sum(rate(app_requests_errors_total[5m])) / sum(rate(app_requests_total[5m])) > bool 0.02) or (avg(app_system_loadavg_1m) > bool 1.5) or (sum(rate(app_requests_success_total[5m])) / sum(rate(app_requests_total[5m])) < bool 0.995))",
          "legendFormat": "alert active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Container: Memory Used",
      "description": "Container-level memory usage in bytes for this service.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "avg(app_container_memory_current)",
          "legendFormat": "container memory used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Container: Memory %",
      "description": "Container memory usage as a percent of limit.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "avg(app_container_memory_percent)",
          "legendFormat": "container memory %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 90 } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Container: CPU Usage",
      "description": "Container CPU usage in nanoseconds.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "avg(app_container_cpu_usage_ns)",
          "legendFormat": "container cpu ns",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Container: Memory Limit",
      "description": "Configured memory limit for the container.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "avg(app_container_memory_limit)",
          "legendFormat": "container memory limit",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Synthetic workload: Request Rate",
      "description": "Shows the current synthetic request volume per second emitted by the internal load generator.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "sum(rate(app_synthetic_requests_total[5m]))",
          "legendFormat": "synthetic req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Synthetic workload: Success Rate",
      "description": "Shows the success percentage for synthetic client requests.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "100 * sum(rate(app_synthetic_requests_success_total[5m])) / sum(rate(app_synthetic_requests_total[5m]))",
          "legendFormat": "synthetic success %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 95 } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Synthetic workload: Failure Rate",
      "description": "Shows the failure percentage for synthetic client requests.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "100 * sum(rate(app_synthetic_requests_errors_total[5m])) / sum(rate(app_synthetic_requests_total[5m]))",
          "legendFormat": "synthetic failure %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 5 } ] }
        }
      }
    },
    {
      "type": "graph",
      "title": "Synthetic workload: Observed Latency (P95)",
      "description": "Shows 95th-percentile client-side latency of synthetic requests.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(app_synthetic_request_duration_bucket[5m])) by (le))",
          "legendFormat": "p95 synthetic latency",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "yaxes": [
        { "format": "s", "label": "seconds", "logBase": 1, "min": 0, "show": true },
        { "format": "short", "show": false }
      ]
    },
    {
      "type": "row",
      "title": "PostgreSQL: Important Database Metrics",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false,
      "showTitle": true
    },
    {
      "type": "stat",
      "title": "Postgres: Active Connections",
      "description": "Tracks the number of active database connections to identify connection pressure.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "max(pg_stat_activity_count{datname=\"observability\"})",
          "legendFormat": "active connections",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 100 } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Postgres: Commit Rate",
      "description": "Shows the transaction commit throughput for the observed database.",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit[5m])) by (datname)",
          "legendFormat": "commits/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Postgres: Rollback Rate",
      "description": "Shows transaction rollback activity to detect failed or retried writes.",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback[5m])) by (datname)",
          "legendFormat": "rollbacks/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Postgres: Cache Hit Rate",
      "description": "Tracks the database cache hit ratio to surface I/O pressure and working set efficiency.",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "100 * sum(rate(pg_stat_database_blks_hit[5m])) by (datname) / sum(rate(pg_stat_database_blks_hit[5m]) + rate(pg_stat_database_blks_read[5m])) by (datname)",
          "legendFormat": "cache hit %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 70 }, { "color": "green", "value": 90 } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Postgres: Version",
      "description": "Reports the PostgreSQL server version reported by the exporter.",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "Mimir" },
      "targets": [
        {
          "expr": "max(pg_postmaster_version)",
          "legendFormat": "version",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        }
      }
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] }
}
