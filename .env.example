# =============================================================================
# Observability Demo — Environment Configuration
# =============================================================================

# Optional: Host machine LAN IP or external virtual hostname
# (Auto-detected by Canary dashboard if left empty)
CANARY_HOST_IP=

# Database Configuration (Overrides defaults in docker-compose.yaml)
POSTGRES_USER=observability
POSTGRES_PASSWORD=observability
POSTGRES_DB=observability

# Optional: Cloudflare Zero Trust Tunnel Token for 24/7 live public showcase
# Get your free tunnel token from:
#   Cloudflare Zero Trust Dashboard -> Networks -> Tunnels -> Create Tunnel
# Once set, start the tunnel with:
#   ./scripts/showcase_tunnel.sh --token
# Or run an instant account-less temporary tunnel with:
#   ./scripts/showcase_tunnel.sh --quick
CLOUDFLARE_TUNNEL_TOKEN=
